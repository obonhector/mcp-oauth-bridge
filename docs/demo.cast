{"version":3,"term":{"cols":100,"rows":30},"timestamp":1794340109,"idle_time_limit":1.0,"command":"bash docs/demo.sh","env":{"SHELL":"/bin/zsh"}}
[0.258, "o", "\u001b[1mMCP OAuth Bridge — local demo (no real account, mock OAuth server)\u001b[0m\r\n"]
[1.013, "o", "\r\n\u001b[1;36m$ oauth-mcp-bridge --version\u001b[0m\r\n"]
[0.641, "o", "MCP OAuth Bridge 1.1.0\r\n"]
[0.821, "o", "\r\n\u001b[1;36m$ oauth-mcp-bridge add demo http://127.0.0.1:60501/mcp --scopes test:read,test:write\u001b[0m\r\n"]
[0.634, "o", "Registered \"demo\" -> http://127.0.0.1:60501/mcp\r\n"]
[0.000, "o", "Next: oauth-mcp-bridge login demo\r\n"]
[0.817, "o", "\r\n\u001b[1;36m$ oauth-mcp-bridge login demo --no-open --port 0\u001b[0m\r\n"]
[0.754, "o", "  AUTHORIZATION_URL=http://127.0.0.1:60501/authorize?response_type=code&client_id=mock-client-b74d65\r\n06-2fef-43af-a7eb-b7882f4ecdb7&code_challenge=W2---aotjHol3YmzMzCPBYNU7rqNSqDXkm6P86fsZrA&code_chall\r\nenge_method=S256&redirect_uri=http%3A%2F%2F127.0.0.1%3A60520%2Fcallback&state=3787fb018d9d785d3f60bf\r\n8d19b0c1fc&scope=test%3Aread+test%3Awrite&resource=http%3A%2F%2F127.0.0.1%3A60501%2Fmcp\r\n"]
[0.812, "o", "\r\n  (following the redirect as the browser would)\r\n"]
[0.083, "o", "  ✅ Authorized \"demo\".\r\n     access_token: yes (expires 2026-11-10T19:49:35.465Z)\r\n     refresh_token: yes\r\n     scope: test:read test:write\r\n     client_id: mock-client-b74d6506-2fef-43af-a7eb-b7882f4ecdb7\r\n     store: /tmp/mcp-oauth-demo.8sd7zW/state/demo.json\r\n"]
[1.011, "o", "\r\n\u001b[1;36m$ oauth-mcp-bridge status demo --offline\u001b[0m\r\n"]
[0.636, "o", "server      : demo -> http://127.0.0.1:60501/mcp\r\n"]
[0.000, "o", "store       : file (/tmp/mcp-oauth-demo.8sd7zW/state/demo.json)\r\nclient_id   : mock-client-b74d6506-2fef-43af-a7eb-b7882f4ecdb7\r\n"]
[0.000, "o", "tokens      : present (expires 2026-11-10T19:49:35.465Z)\r\n"]
[0.000, "o", "refresh     : yes\r\nscope       : test:read test:write\r\nissuer      : http://127.0.0.1:60501\r\nconnection  : not checked (--offline or another process is running)\r\n"]
[1.020, "o", "\r\n\u001b[1;36m$ oauth-mcp-bridge tools demo\u001b[0m\r\n"]
[0.699, "o", "- echo: Returns the text it receives\r\n- server_time: Server time\r\n- echo_meta: Echoes the progress token from _meta\r\n"]
[1.032, "o", "\r\n\u001b[1;36m$ stdio client -> oauth-mcp-bridge serve demo -> mock MCP\u001b[0m\r\n"]
[0.820, "o", "  tools: echo, server_time, echo_meta\r\n"]
[0.006, "o", "  echo:  echo: hello from stdio\r\n"]
[1.022, "o", "\r\n\u001b[1;32mDone.\u001b[0m The token lives in the token store, not in the client config.\r\n"]
[1.022, "x", "0"]
